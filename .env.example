# ==============================================================================
# Portfolio P06: Unified Enterprise RAG System - Environment Configuration
# ==============================================================================

# Break-Glass Administrator Access Key & Cryptographic Session Signing
# Note: Normal users authenticate strictly via Google OAuth/OIDC + personal Google Drive.
# ADMIN_ACCESS_KEY is reserved exclusively for break-glass admin console / telemetry / vector purge.
ADMIN_ACCESS_KEY=your_admin_access_key_here
SESSION_SIGNING_KEY=your_dedicated_high_entropy_session_signing_key_here

# Runtime Environment (production, development, testing)
ENVIRONMENT=production

# Default AI Provider Selection (openai, gemini, nvidia_nim)
AI_PROVIDER=gemini

# Google Gemini Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# OpenAI Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# NVIDIA NIM Provider Configuration (Optional)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2

# ============================================
# QDRANT VECTOR CLOUD (Optional / In-Memory Fallback)
# ============================================
QDRANT_URL=
QDRANT_API_KEY=

# ============================================
# GOOGLE OAUTH & GOOGLE DRIVE INTEGRATION (Required for Normal Users)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://rag.vaikuntrix.in
GOOGLE_ADMIN_EMAILS=admin@vaikuntrix.in

# SQLite Metadata Persistence Path
METADATA_DB_PATH=data/p06_metadata.db
