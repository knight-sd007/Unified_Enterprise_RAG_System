# ==============================================================================
# Docker Build Context Exclusion Rules (.dockerignore)
# ==============================================================================

# Version Control & Metadata
.git/
.gitignore
.gitattributes

# Python Virtual Environments & Packages
.venv/
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.cache/

# Secrets & Environment Files (CRITICAL)
.env
.env.*
.streamlit/secrets.toml
*.pem
*.key
*.crt

# Tests & Documentation (Not needed in runtime container)
tests/
docs/
*.md

# IDE & OS Metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# CI/CD & Orchestration Files
Dockerfile
docker-compose.yml
docker-compose*.yml
Jenkinsfile
deploy/
